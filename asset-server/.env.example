# ==========================================
# ShotAi Asset Server Environment Configuration
# ==========================================

# Server binding
PORT=3100
HOST=127.0.0.1
NODE_ENV=production

# Database Connection (PostgreSQL 18)
# Host: 127.0.0.1, Port: 5432, Database: shotaistudio, User: shotaistudio
DATABASE_URL=postgresql://shotaistudio:salmanbs@127.0.0.1:5432/shotaistudio

# Storage Root Directory (Default for Ubuntu 22.04 / aaPanel)
# For local Windows development testing, you can change this to ./storage
STORAGE_ROOT=/www/wwwroot/shotai-assets

# Security: Admin API Key for Uploads
0401bca95814aa6eab858ded3f2e884371737ad9e049fa6e86773f5f79921b9a

# CORS Configuration (Comma-separated)
ALLOWED_ORIGINS=https://domain-shotai.com,http://localhost:5173,http://localhost:3000
